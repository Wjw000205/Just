# 复制为 .env 后逐项替换。不要提交真实密钥。
RDP_STORAGE_PASSWORD=ChangeStoragePassword_2026!
RDP_BOOTSTRAP_ADMIN_PASSWORD=ChangeAdminPassword_2026!
RDP_JWT_SECRET=replace-with-at-least-32-random-characters-jwt
RDP_AUDIT_SECRET=replace-with-at-least-32-random-characters-audit
RDP_AUDIT_KEY_ID=prod-v1
RDP_AUDIT_PREVIOUS_KEYS=
RDP_DATA_ENCRYPTION_KEY=replace-with-at-least-32-random-characters-data
# HTTP规范载荷交付默认关闭。生产只填写经批准的HTTPS适配器主机，逗号分隔。
RDP_INTEGRATION_DELIVERY_ALLOWED_HOSTS=
RDP_INTEGRATION_ALLOW_PRIVATE_DELIVERY_HOSTS=false
# OAuth2自省端精确主机白名单；生产仅列经批准的HTTPS身份提供方，并配合受信DNS/出口防火墙。
RDP_INTEGRATION_OAUTH_INTROSPECTION_ALLOWED_HOSTS=
RDP_INTEGRATION_ALLOW_PRIVATE_OAUTH_HOSTS=false
RDP_WEB_PORT=8088
RDP_SECURE_COOKIES=false
RDP_REQUIRE_VIRUS_SCAN=false
# 自助注册默认关闭。SIMULATED 仅用于本机自动验收，不会向真实邮箱/手机发送验证码。
RDP_REGISTRATION_ENABLED=false
RDP_REGISTRATION_CHANNELS=EMAIL,PHONE
RDP_REGISTRATION_NOTIFICATION_ADAPTER=SIMULATED
RDP_AUTH_RATE_WINDOW_SECONDS=600
RDP_CAPTCHA_IP_RATE_LIMIT=300
RDP_CAPTCHA_GLOBAL_RATE_LIMIT=5000
RDP_LOGIN_IP_RATE_LIMIT=100
RDP_LOGIN_GLOBAL_RATE_LIMIT=5000
